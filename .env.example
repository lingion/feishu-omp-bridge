# Feishu app credentials.
# Leave empty on first run and use `bun run register-app` to scan a QR code
# that auto-creates a Feishu self-built app and fills these in.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Comma-separated Feishu open_id values allowed to drive the agent.
# Empty = allow anyone who can DM the bot (not recommended).
FEISHU_ALLOWED_OPEN_IDS=

# Working directory omp sessions operate in. Defaults to this repo's parent.
OMP_CWD=

# Optional: pin a model, e.g. "anthropic/claude-sonnet-4". Empty = omp default.
OMP_MODEL=

# Lark international version? Set to "1" to switch domain to open.larksuite.com
FEISHU_LARK_INTERNATIONAL=
