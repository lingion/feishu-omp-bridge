{
  "name": "feishu-omp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bidirectional bridge: chat with the omp (Oh My Pi) agent from Feishu/Lark.",
  "scripts": {
    "start": "bun run src/index.ts",
    "service:install": "bun run src/index.ts service install",
    "service:uninstall": "bun run src/index.ts service uninstall",
    "typecheck": "tsc --noEmit",
    "register-app": "bun run src/onboard.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@oh-my-pi/pi-coding-agent": "17.2.10",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
